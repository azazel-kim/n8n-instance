    {
      "parameters": {
        "sendTo": "={{ $('문서 요청 폼').first().json['이메일 (결과 수신용)'] }}",
        "subject": "=문서 작성 완료: {{ $('문서 데이터 처리').first().json.title }}",
        "message": "=안녕하세요,\n\n요청하신 문서 '{{ $('문서 데이터 처리').first().json.title }}'의 초안이 작성되었습니다.\n\n📄 Google Drive 링크: {{ $json.webViewLink }}\n\n📝 문서 정보:\n- 문서 유형: {{ $('문서 데이터 처리').first().json.type }}\n- 작성일: {{ $('문서 데이터 처리').first().json.createdAt }}\n\n💡 한글(HWP) 파일로 변환하려면:\n1. 위 링크에서 HTML 파일을 다운로드하세요\n2. 한글 프로그램에서 '파일 > 불러오기 > HTML'로 열어주세요\n3. 필요한 서식을 조정한 후 HWP로 저장하세요\n\n감사합니다.",
        "options": {}
      },
      "id": "email-notification",
      "name": "이메일 알림",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1320, 0],
      "credentials": {
