          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=✅ 문서 작성이 완료되었습니다!\n\n📄 문서 제목: {{ $('문서 데이터 처리').first().json.title }}\n📧 결과가 이메일로 발송되었습니다.\n\n감사합니다!"
      },
