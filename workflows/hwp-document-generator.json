          "mode": "list"
        },
        "name": "={{ $('문서 데이터 처리').first().json.fileName }}.html",
        "options": {}
      },
      "id": "google-drive",
      "name": "Google Drive 업로드",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1100, 0],
